"""
OTLS TLS 1.3 Handshake (field-mode): X25519 shared secret computed inside MPC.

This is *not* classical finite-field DH (g^a mod p). X25519 is Diffie–Hellman on
Curve25519: each side has a scalar k and a Montgomery u-coordinate; the shared
secret is the u-coordinate of k * Q (RFC 7748), computed here with a Montgomery
ladder in the prime field mod p = 2^255 - 19.

Secret sharing (what this file does):
  - The *client scalar* k (32-byte clamped private key) is represented as three
    *additive* shares mod 2^256: k = k0 + k1 + k2 (mod 2^256). Each share arrives
    as 4 x 64-bit BE words of private sint (12 words total) via
    sint.receive_from_client(...).
  - Those shares are *recombined inside MPC* (see add_three_scalar_shares_bits)
    to 256 scalar bits; no single party’s transcript needs the full k in clear.
  - Today the ExternalIO client often *splits* one local key into k0,k1,k2 for
    wiring; a future variant can have each party supply one share from its own input.

Where the "shared secret" appears:
  - x25519_ladder_bits_scalar(k_bits, u) computes the X25519 output (Montgomery
    u-coordinate of the ECDH result) as a field element out_x.
  - field_x25519_out_to_ss_bv(out_x) turns that into a 32-byte sbitvec ss_bv —
    that byte string is what TLS 1.3 uses as IKM into HKDF together with the
    transcript hashes (derive_hs_keys / derive_app_keys in otls_crypto.mpc).

ExternalIO (client must match order):
  1) transcript SHA-256(CH||SH): 4 public words — send_public_inputs_raw64
  2) client scalar as 3 additive shares mod 2^256: 12 private sint words
     (each share = 4 x 64-bit BE words; client splits raw 32-byte key).
  3) server X25519 public key: 4 public regint words (BE chunks)
  4) encrypted HS records, then th_sf, HTTP, response — raw64 public

Compile: ./compile.py -F 253 -P <Curve25519 prime>
Run: replicated-field-party.x with same -P at runtime.
"""

from Compiler.GC.types import sbitint

_oc_ns = dict(globals())
exec(compile(open('Programs/Source/otls_crypto.mpc').read(),
             'Programs/Source/otls_crypto.mpc', 'exec'), _oc_ns)

_CRYPTO_EXPORTS = (
    'bv_xor', 'bv_cat', 'bv_zeros', 'bv_hex', 'bv_slice', 'bv_reverse', 'sha256',
    'hmac_sha256', 'hkdf_extract', 'hkdf_expand', 'hkdf_expand_label', 'derive_secret',
    'aes128_encrypt_block', 'aes128_gcm_encrypt', 'empty_hash', 'tls_nonce', 'tls_nonce_r',
    'gcm_ctr', 'derive_hs_keys_from_th_hash', 'derive_app_keys_from_th_hash', 'build_tls_record',
)
for _n in _CRYPTO_EXPORTS:
    globals()[_n] = _oc_ns[_n]

derive_hs_keys = derive_hs_keys_from_th_hash
derive_app_keys = derive_app_keys_from_th_hash

# Avoid allocator reordering of memory ops (warning: "Order of memory instructions not
# preserved") — can miscompile Array-heavy crypto and yield wrong HS keys / garbage TLS.
program.options.preserve_mem_order = True

P25519 = (1 << 255) - 19
A24 = 121665

PORTNUM = 18000
REC_BUF_BYTES = 2560
REC_BUF_WORDS = 320
APP_BUF_BYTES = 1024
APP_BUF_WORDS = 128
MAX_HS_RECORDS = 5
MAX_RESP_RECORDS = 2
HS_CT_BYTES = REC_BUF_BYTES - 21
RESP_CT_BYTES = APP_BUF_BYTES - 21
REQ_MAX_BYTES = 256

# --- Scalar share packing (wire format from ExternalIO client) ----------------
# Each share is four 64-bit big-endian words = 256 bits of that share.


def sint_words_be_to_bits_le(words4):
    """4 sint BE words -> 256 LSB-first bits (matches client scalar packing)."""
    sb64 = sbitint.get_type(64)
    bits_le = []
    for w in range(4):
        chunk_bits_le = sb64(words4[w]).bit_decompose()
        for b in range(8):
            src = (7 - b) * 8
            bits_le.extend(chunk_bits_le[src:src + 8])
    return bits_le[:256]


def _cswap_field(bit, a, b):
    t = bit * (a - b)
    return a - t, b + t


def regint_words_to_u_sint(words4):
    """Decode server's X25519 public key u from 4 regint words (32-byte LE u-coordinate).

    This is the peer Montgomery point (u only); it is *public* on the wire.
    Uses BITDECINT for byte extraction — regint ``&`` goes through cint (field mod p)
    which silently corrupts masking results for negative regint values (unsigned > 2^63).
    """
    all_bits_le = []
    for w in range(4):
        word_bits = words4[w].bit_decompose(64)
        for b in range(8):
            src = (7 - b) * 8
            all_bits_le.extend(word_bits[src:src + 8])
    u = sint(0)
    for i in range(255, -1, -1):
        u = u * sint(2) + sint(all_bits_le[i])
    return u


def x25519_ladder_bits_scalar(k_bits_in, u_elem):
    """X25519: compute shared Montgomery u-coordinate for scalar k on peer public u_elem.

    This is the curve analogue of DH: result = X25519(k, u) (RFC 7748), using a
    constant-time Montgomery ladder in F_p, p = 2^255-19. Inputs:
      k_bits_in: 256 scalar bits (LSB first) — the recombined private scalar.
      u_elem:    field element for server's u-coordinate.
    Returns: field element = shared secret *before* byte serialization (then fixed
    in field_x25519_out_to_ss_bv). Classical "g^a mod p" does not apply; this is
    elliptic-curve scalar multiplication in the Montgomery model.
    """
    kb = [sint(k_bits_in[i]) for i in range(256)]
    kb[0] = sint(0)
    kb[1] = sint(0)
    kb[2] = sint(0)
    kb[255] = sint(0)
    kb[254] = sint(1)
    k_bits = kb[:255]

    x1 = u_elem
    x2 = sint(1)
    z2 = sint(0)
    x3 = x1
    z3 = sint(1)
    swap = sint(0)

    for t in range(254, -1, -1):
        b = k_bits[t]
        swap = swap + b - sint(2) * swap * b
        x2, x3 = _cswap_field(swap, x2, x3)
        z2, z3 = _cswap_field(swap, z2, z3)
        swap = b

        A = x2 + z2
        AA = A * A
        B = x2 - z2
        BB = B * B
        E = AA - BB
        C = x3 + z3
        D = x3 - z3
        DA = D * A
        CB = C * B
        ApB = DA + CB
        x3 = ApB * ApB
        # z3 = x1 * (DA-CB)^2 mod p — must square (DA-CB) before multiplying by x1;
        # x1*(DA-CB)*(DA-CB) would associate as (x1*(DA-CB))*(DA-CB), which is wrong mod p.
        DmC = DA - CB
        z3 = x1 * (DmC * DmC)
        x2 = AA * BB
        z2 = E * (AA + sint(A24) * E)

    x2, x3 = _cswap_field(swap, x2, x3)
    z2, z3 = _cswap_field(swap, z2, z3)

    e = P25519 - 2
    inv = sint(1)
    base = z2
    for i in range(e.bit_length() - 1, -1, -1):
        inv = inv * inv
        if (e >> i) & 1:
            inv = inv * base
    return x2 * inv


def field_x25519_out_to_ss_bv(out):
    """Same HKDF bit order as sint_chunks_to_bv(pack_bytes(LE secret)) / otls_demo ring path.

    bits_le[i] is bit i of integer V (LSB at i=0). Ring code builds the sbitvec as
    reversed(sb64(word).bit_decompose()) per 64-bit BE word — i.e. per byte of the
    secret, bits MSB..LSB (big-endian bit order within each byte), bytes in order
    b[0]..b[31]. Equivalently: for each byte index j, append bits_le[8*j+7]..bits_le[8*j].

    Do this in the sbit domain only; rebuilding sint words with sint(bits_le[i]) can
    mis-compile and yield wrong keys even when the algebra matches pack_bytes.
    """
    v = (out < sint(0)).if_else(out + sint(P25519), out)
    sb255 = sbitint.get_type(255)
    bits_le = sb255(v).bit_decompose() + [sbit(0)]
    bits = []
    for byte_idx in range(32):
        for i in range(7, -1, -1):
            bits.append(bits_le[byte_idx * 8 + i])
    return sbitvec.from_vec(bits)


def _add256_mod(a_bits, b_bits):
    """(a + b) mod 2^256; a_bits,b_bits are 256 LSB-first sbits (unsigned)."""
    sb257 = sbitint.get_type(257)
    pad1 = [sbit(0)]
    a = sb257.bit_compose(a_bits[:256] + pad1)
    b = sb257.bit_compose(b_bits[:256] + pad1)
    s = a + b
    return s.bit_decompose()[:256]


def add_three_scalar_shares_bits(b0, b1, b2):
    """Recombine three additive shares mod 2^256 (unsigned), LSB-first bits per share.

    Per-bit gfp ``sint`` add is unsafe (mod p, not Z). One wide ``a+b+c`` on ``sbitint``
    is easy to get wrong (signed range / semantics).  Instead:
    ``((b0+b1) mod 2^256 + b2) mod 2^256 = (b0+b1+b2) mod 2^256`` using 257-bit adds.
    """
    ab = _add256_mod(b0, b1)
    return _add256_mod(ab, b2)


def regint_words_to_bv(words, n_bytes):
    """Uses BITDECINT to avoid regint & cint corruption for negative regint values."""
    bits = []
    for w_idx in range(n_bytes // 8 + (1 if n_bytes % 8 else 0)):
        word_bits = words[w_idx].bit_decompose(64)
        for b_in_w in range(8):
            byte_idx = w_idx * 8 + b_in_w
            if byte_idx >= n_bytes:
                break
            base = (7 - b_in_w) * 8
            for bit in range(8):
                bits.append(sbit(word_bits[base + 7 - bit]))
    return sbitvec.from_vec(bits[:n_bytes * 8])


def bv_reveal_to_sint_words(bv, n_bytes, max_words):
    result = Array(max_words, sint)
    for w in range(max_words):
        val = regint(0)
        for b_in_w in range(8):
            bi = w * 8 + b_in_w
            if bi >= n_bytes:
                break
            byte_val = regint(0)
            for bit in range(8):
                idx = bi * 8 + bit
                if idx < len(bv.v):
                    byte_val = byte_val + regint(bv.v[idx].reveal()) * regint(1 << (7 - bit))
            val = val + byte_val * regint(1 << ((7 - b_in_w) * 8))
        result[w] = sint(val)
    return result


print_ln('otls(field): start')
listen_for_clients(PORTNUM)
print_ln('otls(field): waiting on port %s', PORTNUM)
cid = accept_client_connection(PORTNUM)
print_ln('otls(field): gateway connected')

# --- Public transcript hash th(CH||SH) (TLS exporter labels use this later) ---
th_ch_sh_w = regint.read_from_socket(cid, 4)
th_bv = regint_words_to_bv(th_ch_sh_w, 32)

# --- Secret-shared client scalar: 3 additive shares mod 2^256, then X25519 --------
# receive_from_client: 12 private sint words = masked triples from preprocessing;
# protocol reconstructs additive shares of the scalar k across parties.
scalar_inp = sint.receive_from_client(12, cid)
share0 = [scalar_inp[i] for i in range(4)]
share1 = [scalar_inp[i] for i in range(4, 8)]
share2 = [scalar_inp[i] for i in range(8, 12)]
bits0 = sint_words_be_to_bits_le(share0)
bits1 = sint_words_be_to_bits_le(share1)
bits2 = sint_words_be_to_bits_le(share2)
# k_bits = recombined scalar bits (still secret-shared in the computation).
k_bits = add_three_scalar_shares_bits(bits0, bits1, bits2)

# Peer's public key u (from ServerHello key_share); public regint words from client.
server_pub = regint.read_from_socket(cid, 4)
u = regint_words_to_u_sint(server_pub)
# ECDH in MPC: out_x is the X25519 shared field element (Montgomery u output).
out_x = x25519_ladder_bits_scalar(k_bits, u)
# ss_bv = 32-byte shared secret as bits — the TLS 1.3 ECDH IKM for HKDF in derive_*.
ss_bv = field_x25519_out_to_ss_bv(out_x)

n_enc = regint.read_from_socket(cid)

rec_data = []
for i in range(MAX_HS_RECORDS):
    h = regint.read_from_socket(cid, 1 + REC_BUF_WORDS)
    rec_data.append(h)

# --- HKDF / handshake keys: IKM = ss_bv from X25519 above + transcript th_bv ---
print_ln('otls(field): deriving HS keys')
hs_sec, s_key, s_iv, c_key, c_iv, fin_key = derive_hs_keys(ss_bv, th_bv)
print_ln('otls(field): HS keys done')

dest = Array(1, regint)
dest[0] = cid
for ri in range(MAX_HS_RECORDS):
    r = rec_data[ri]
    r_bv = regint_words_to_bv(r[1:], REC_BUF_BYTES)
    ct_bv = bv_slice(r_bv, 40, 40 + HS_CT_BYTES * 8)
    nonce_i = tls_nonce(s_iv, ri)
    plain_i = gcm_ctr(s_key, nonce_i, ct_bv, HS_CT_BYTES)
    words_i = bv_reveal_to_sint_words(plain_i, HS_CT_BYTES, REC_BUF_WORDS)
    out_i = Array(1 + REC_BUF_WORDS, sint)
    out_i[0] = sint(HS_CT_BYTES)
    for j in range(REC_BUF_WORDS):
        out_i[1 + j] = words_i[j]
    sint.reveal_to_clients(dest, [out_i[k] for k in range(1 + REC_BUF_WORDS)])

th_sf_w = regint.read_from_socket(cid, 4)
th_sf_bv = regint_words_to_bv(th_sf_w, 32)

req_h = regint.read_from_socket(cid, 1 + APP_BUF_WORDS)
req_bv = regint_words_to_bv(req_h[1:], REQ_MAX_BYTES)

vd = hmac_sha256(fin_key, th_sf_bv)
fin_msg = bv_cat(bv_hex('14000020'), vd)
fin_rec, fin_rec_len = build_tls_record(c_key, c_iv, 0, fin_msg, 36, 0x16)

# Application traffic keys (still derived from same hs_sec / transcript chain).
ck, ci, sk, si = derive_app_keys(hs_sec, th_sf_bv)
app_rec, app_rec_len = build_tls_record(ck, ci, 0, req_bv, REQ_MAX_BYTES, 0x17)

fw = bv_reveal_to_sint_words(fin_rec, fin_rec_len, APP_BUF_WORDS)
fo = Array(1 + APP_BUF_WORDS, sint)
fo[0] = sint(fin_rec_len)
for i in range(APP_BUF_WORDS):
    fo[1 + i] = fw[i]
sint.reveal_to_clients(dest, [fo[i] for i in range(1 + APP_BUF_WORDS)])

aw = bv_reveal_to_sint_words(app_rec, app_rec_len, APP_BUF_WORDS)
ao = Array(1 + APP_BUF_WORDS, sint)
ao[0] = sint(app_rec_len)
for i in range(APP_BUF_WORDS):
    ao[1 + i] = aw[i]
sint.reveal_to_clients(dest, [ao[i] for i in range(1 + APP_BUF_WORDS)])

srv_app_seq = regint.read_from_socket(cid)
n_resp = regint.read_from_socket(cid)
resp_data = []
for i in range(MAX_RESP_RECORDS):
    h = regint.read_from_socket(cid, 1 + APP_BUF_WORDS)
    resp_data.append(h)

rr0 = resp_data[0]
rr0_bv = regint_words_to_bv(rr0[1:], APP_BUF_BYTES)
resp_ct = bv_slice(rr0_bv, 40, 40 + RESP_CT_BYTES * 8)
resp_nonce = tls_nonce_r(si, srv_app_seq)
resp_plain = gcm_ctr(sk, resp_nonce, resp_ct, RESP_CT_BYTES)

rw = bv_reveal_to_sint_words(resp_plain, RESP_CT_BYTES, APP_BUF_WORDS)
ro = Array(1 + APP_BUF_WORDS, sint)
ro[0] = sint(RESP_CT_BYTES)
for i in range(APP_BUF_WORDS):
    ro[1 + i] = rw[i]
sint.reveal_to_clients(dest, [ro[i] for i in range(1 + APP_BUF_WORDS)])

closeclientconnection(cid)
print_ln('otls(field): done')
