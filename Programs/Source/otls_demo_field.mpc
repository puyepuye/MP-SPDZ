"""
OTLS TLS 1.3 Handshake (field-mode): X25519 shared secret computed inside MPC.

ExternalIO (gateway must match order):
  1) transcript SHA-256(CH||SH): 4 public words — send_public_inputs_raw64
  2) client scalar as 3 additive shares mod 2^256: 12 private sint words
     (each share = 4 x 64-bit BE words; gateway splits raw 32-byte key).
  3) server X25519 public key: 4 public regint words (BE chunks)
  4) encrypted HS records, then th_sf, HTTP, response — raw64 public

Shares are reconstructed in MPC (bitwise add mod 2) before the Montgomery ladder.
Independent parties would each supply one share via separate clients (future).

Compile: ./compile.py -F 253 -P <Curve25519 prime>
Run: replicated-field-party.x with same -P at runtime.
"""

from Compiler.GC.types import sbitint

_oc_ns = dict(globals())
exec(compile(open('Programs/Source/otls_crypto.mpc').read(),
             'Programs/Source/otls_crypto.mpc', 'exec'), _oc_ns)

_CRYPTO_EXPORTS = (
    'bv_xor', 'bv_cat', 'bv_zeros', 'bv_hex', 'bv_slice', 'bv_reverse', 'sha256',
    'hmac_sha256', 'hkdf_extract', 'hkdf_expand', 'hkdf_expand_label', 'derive_secret',
    'aes128_encrypt_block', 'aes128_gcm_encrypt', 'empty_hash', 'tls_nonce', 'tls_nonce_r',
    'gcm_ctr', 'derive_hs_keys_from_th_hash', 'derive_app_keys_from_th_hash', 'build_tls_record',
)
for _n in _CRYPTO_EXPORTS:
    globals()[_n] = _oc_ns[_n]

derive_hs_keys = derive_hs_keys_from_th_hash
derive_app_keys = derive_app_keys_from_th_hash

P25519 = (1 << 255) - 19
A24 = 121665

PORTNUM = 18000
REC_BUF_BYTES = 2560
REC_BUF_WORDS = 320
APP_BUF_BYTES = 1024
APP_BUF_WORDS = 128
MAX_HS_RECORDS = 5
MAX_RESP_RECORDS = 2
HS_CT_BYTES = REC_BUF_BYTES - 21
RESP_CT_BYTES = APP_BUF_BYTES - 21
REQ_MAX_BYTES = 256


def sint_words_be_to_bits_le(words4):
    """4 sint BE words -> 256 LSB-first bits (matches gateway scalar packing)."""
    sb64 = sbitint.get_type(64)
    bits_le = []
    for w in range(4):
        chunk_bits_le = sb64(words4[w]).bit_decompose()
        for b in range(8):
            src = (7 - b) * 8
            bits_le.extend(chunk_bits_le[src:src + 8])
    return bits_le[:256]


def _cswap_field(bit, a, b):
    t = bit * (a - b)
    return a - t, b + t


def regint_words_to_u_sint(words4):
    """32-byte LE X25519 u-coordinate -> field sint (same as otls_x25519_prime_test hex_le_to_sint)."""
    v = sint(0)
    for i in range(31, -1, -1):
        w = i // 8
        bi = i % 8
        byte_r = (words4[w] >> regint(8 * (7 - bi))) & regint(0xFF)
        v = v * sint(256) + sint(byte_r)
    return v


def x25519_ladder_bits_scalar(k_bits_in, u_elem):
    """Montgomery ladder; k_bits_in = 256 LSB-first scalar bits (sint or sbit); u = server public."""
    kb = [sint(k_bits_in[i]) for i in range(256)]
    kb[0] = sint(0)
    kb[1] = sint(0)
    kb[2] = sint(0)
    kb[255] = sint(0)
    kb[254] = sint(1)
    k_bits = kb[:255]

    x1 = u_elem
    x2 = sint(1)
    z2 = sint(0)
    x3 = x1
    z3 = sint(1)
    swap = sint(0)

    for t in range(254, -1, -1):
        b = k_bits[t]
        swap = swap + b - sint(2) * swap * b
        x2, x3 = _cswap_field(swap, x2, x3)
        z2, z3 = _cswap_field(swap, z2, z3)
        swap = b

        A = x2 + z2
        AA = A * A
        B = x2 - z2
        BB = B * B
        E = AA - BB
        C = x3 + z3
        D = x3 - z3
        DA = D * A
        CB = C * B
        x3 = (DA + CB) * (DA + CB)
        z3 = x1 * (DA - CB) * (DA - CB)
        x2 = AA * BB
        z2 = E * (AA + sint(A24) * E)

    x2, x3 = _cswap_field(swap, x2, x3)
    z2, z3 = _cswap_field(swap, z2, z3)

    e = P25519 - 2
    inv = sint(1)
    base = z2
    for i in range(e.bit_length() - 1, -1, -1):
        inv = inv * inv
        if (e >> i) & 1:
            inv = inv * base
    return x2 * inv


def field_x25519_out_to_ss_bv(out):
    """Field element -> 32-byte MSB-first sbitvec for otls_crypto."""
    out = (out < sint(0)).if_else(out + sint(P25519), out)
    sb255 = sbitint.get_type(255)
    bits_le = sb255(out).bit_decompose() + [sbit(0)]
    out_bits = []
    for byte_i in range(32):
        base = byte_i * 8
        for bit_i in range(7, -1, -1):
            out_bits.append(bits_le[base + bit_i])
    return sbitvec.from_vec(out_bits)


def add_three_scalar_shares_bits(b0, b1, b2):
    """
    b0,b1,b2: 256 LSB-first bits per share; additive shares mod 2^256.
    Carry via s >> 1 (int_div(..., bit_length=4) broke the reconstructed scalar).
    """
    carry = sint(0)
    out = []
    for i in range(256):
        s = sint(b0[i]) + sint(b1[i]) + sint(b2[i]) + carry
        out.append(s % 2)
        carry = s >> 1
    return out


def regint_words_to_bv(words, n_bytes):
    bits = []
    for w_idx in range(n_bytes // 8 + (1 if n_bytes % 8 else 0)):
        word = words[w_idx]
        for b_in_w in range(8):
            byte_idx = w_idx * 8 + b_in_w
            if byte_idx >= n_bytes:
                break
            byte_val = (word >> regint((7 - b_in_w) * 8)) & regint(0xFF)
            for bit in range(8):
                bits.append(sbit((byte_val >> regint(7 - bit)) & regint(1)))
    return sbitvec.from_vec(bits[:n_bytes * 8])


def bv_reveal_to_sint_words(bv, n_bytes, max_words):
    result = Array(max_words, sint)
    for w in range(max_words):
        val = regint(0)
        for b_in_w in range(8):
            bi = w * 8 + b_in_w
            if bi >= n_bytes:
                break
            byte_val = regint(0)
            for bit in range(8):
                idx = bi * 8 + bit
                if idx < len(bv.v):
                    byte_val = byte_val + regint(bv.v[idx].reveal()) * regint(1 << (7 - bit))
            val = val + byte_val * regint(1 << ((7 - b_in_w) * 8))
        result[w] = sint(val)
    return result


print_ln('otls(field): start')
listen_for_clients(PORTNUM)
print_ln('otls(field): waiting on port %s', PORTNUM)
cid = accept_client_connection(PORTNUM)
print_ln('otls(field): gateway connected')

th_ch_sh_w = regint.read_from_socket(cid, 4)
th_bv = regint_words_to_bv(th_ch_sh_w, 32)

# Three additive shares of the client scalar (each 4 words); reconstruct mod 2^256.
scalar_inp = sint.receive_from_client(12, cid)
share0 = [scalar_inp[i] for i in range(4)]
share1 = [scalar_inp[i] for i in range(4, 8)]
share2 = [scalar_inp[i] for i in range(8, 12)]
bits0 = sint_words_be_to_bits_le(share0)
bits1 = sint_words_be_to_bits_le(share1)
bits2 = sint_words_be_to_bits_le(share2)
k_bits = add_three_scalar_shares_bits(bits0, bits1, bits2)

server_pub = regint.read_from_socket(cid, 4)
u = regint_words_to_u_sint(server_pub)
out_x = x25519_ladder_bits_scalar(k_bits, u)
ss_bv = field_x25519_out_to_ss_bv(out_x)

n_enc = regint.read_from_socket(cid)

rec_data = []
for i in range(MAX_HS_RECORDS):
    h = regint.read_from_socket(cid, 1 + REC_BUF_WORDS)
    rec_data.append(h)

print_ln('otls(field): deriving HS keys')
hs_sec, s_key, s_iv, c_key, c_iv, fin_key = derive_hs_keys(ss_bv, th_bv)
print_ln('otls(field): HS keys done')

dest = Array(1, regint)
dest[0] = cid
for ri in range(MAX_HS_RECORDS):
    r = rec_data[ri]
    r_bv = regint_words_to_bv(r[1:], REC_BUF_BYTES)
    ct_bv = bv_slice(r_bv, 40, 40 + HS_CT_BYTES * 8)
    nonce_i = tls_nonce(s_iv, ri)
    plain_i = gcm_ctr(s_key, nonce_i, ct_bv, HS_CT_BYTES)
    words_i = bv_reveal_to_sint_words(plain_i, HS_CT_BYTES, REC_BUF_WORDS)
    out_i = Array(1 + REC_BUF_WORDS, sint)
    out_i[0] = sint(HS_CT_BYTES)
    for j in range(REC_BUF_WORDS):
        out_i[1 + j] = words_i[j]
    sint.reveal_to_clients(dest, [out_i[k] for k in range(1 + REC_BUF_WORDS)])

th_sf_w = regint.read_from_socket(cid, 4)
th_sf_bv = regint_words_to_bv(th_sf_w, 32)

req_h = regint.read_from_socket(cid, 1 + APP_BUF_WORDS)
req_bv = regint_words_to_bv(req_h[1:], REQ_MAX_BYTES)

vd = hmac_sha256(fin_key, th_sf_bv)
fin_msg = bv_cat(bv_hex('14000020'), vd)
fin_rec, fin_rec_len = build_tls_record(c_key, c_iv, 0, fin_msg, 36, 0x16)

ck, ci, sk, si = derive_app_keys(hs_sec, th_sf_bv)
app_rec, app_rec_len = build_tls_record(ck, ci, 0, req_bv, REQ_MAX_BYTES, 0x17)

fw = bv_reveal_to_sint_words(fin_rec, fin_rec_len, APP_BUF_WORDS)
fo = Array(1 + APP_BUF_WORDS, sint)
fo[0] = sint(fin_rec_len)
for i in range(APP_BUF_WORDS):
    fo[1 + i] = fw[i]
sint.reveal_to_clients(dest, [fo[i] for i in range(1 + APP_BUF_WORDS)])

aw = bv_reveal_to_sint_words(app_rec, app_rec_len, APP_BUF_WORDS)
ao = Array(1 + APP_BUF_WORDS, sint)
ao[0] = sint(app_rec_len)
for i in range(APP_BUF_WORDS):
    ao[1 + i] = aw[i]
sint.reveal_to_clients(dest, [ao[i] for i in range(1 + APP_BUF_WORDS)])

srv_app_seq = regint.read_from_socket(cid)
n_resp = regint.read_from_socket(cid)
resp_data = []
for i in range(MAX_RESP_RECORDS):
    h = regint.read_from_socket(cid, 1 + APP_BUF_WORDS)
    resp_data.append(h)

rr0 = resp_data[0]
rr0_bv = regint_words_to_bv(rr0[1:], APP_BUF_BYTES)
resp_ct = bv_slice(rr0_bv, 40, 40 + RESP_CT_BYTES * 8)
resp_nonce = tls_nonce_r(si, srv_app_seq)
resp_plain = gcm_ctr(sk, resp_nonce, resp_ct, RESP_CT_BYTES)

rw = bv_reveal_to_sint_words(resp_plain, RESP_CT_BYTES, APP_BUF_WORDS)
ro = Array(1 + APP_BUF_WORDS, sint)
ro[0] = sint(RESP_CT_BYTES)
for i in range(APP_BUF_WORDS):
    ro[1 + i] = rw[i]
sint.reveal_to_clients(dest, [ro[i] for i in range(1 + APP_BUF_WORDS)])

closeclientconnection(cid)
print_ln('otls(field): done')
