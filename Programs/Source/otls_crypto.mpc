"""
OTLS crypto library: HMAC-SHA256, HKDF, AES-128-GCM — all in MPC.
Uses Bristol Fashion circuits for SHA-256 and AES-128.
"""

from circuit import sha256 as _sha256_raw, Circuit

aes128_circuit = Circuit('aes_128')

# ============================================================
# sbitvec helpers -- a vector of secret bits
# ============================================================

def bv_xor(a, b):
    """XOR two equal-length sbitvecs."""
    return sbitvec.from_vec([a.v[i] ^ b.v[i] for i in range(len(a.v))])

def bv_cat(*vecs):
    """Concatenate sbitvecs."""
    bits = []
    for v in vecs:
        bits.extend(v.v)
    return sbitvec.from_vec(bits)

def bv_zeros(n_bits):
    return sbitvec.from_vec([sbit(0)] * n_bits)

def bv_hex(h):
    """sbitvec from hex string, big-endian (MSB first)."""
    return sbitvec.from_hex(h, reverse=False)

def bv_slice(v, start_bit, end_bit):
    """Slice a sbitvec [start_bit:end_bit)."""
    return sbitvec.from_vec(v.v[start_bit:end_bit])

def bv_reverse(v):
    return sbitvec.from_vec(list(reversed(v.v)))

def sha256(x):
    """SHA-256 returning MSB-first sbitvec (same convention as bv_hex)."""
    return bv_reverse(_sha256_raw(x))

# ============================================================
# HMAC-SHA256
# ============================================================

_IPAD = bv_hex('36' * 64)  # 512 bits
_OPAD = bv_hex('5c' * 64)  # 512 bits

def hmac_sha256(key_bv, msg_bv):
    """HMAC-SHA256(key, msg). key and msg are sbitvecs."""
    klen = len(key_bv.v)
    if klen > 512:
        key_bv = sha256(key_bv)
        klen = 256
    if klen < 512:
        key_bv = bv_cat(key_bv, bv_zeros(512 - klen))
    inner = sha256(bv_cat(bv_xor(key_bv, _IPAD), msg_bv))
    return sha256(bv_cat(bv_xor(key_bv, _OPAD), inner))

# ============================================================
# HKDF (RFC 5869)
# ============================================================

def hkdf_extract(salt_bv, ikm_bv):
    """HKDF-Extract = HMAC-SHA256(salt, IKM). Returns 256-bit PRK."""
    return hmac_sha256(salt_bv, ikm_bv)

def hkdf_expand(prk_bv, info_bv, length):
    """HKDF-Expand. length <= 32 for single-block output."""
    t1 = hmac_sha256(prk_bv, bv_cat(info_bv, bv_hex('01')))
    if length <= 32:
        return bv_slice(t1, 0, length * 8)
    t2 = hmac_sha256(prk_bv, bv_cat(t1, info_bv, bv_hex('02')))
    return bv_slice(bv_cat(t1, t2), 0, length * 8)

def _hkdf_label(length, label_ascii, context_bv):
    """Build HkdfLabel struct as sbitvec.
    HkdfLabel = uint16(length) || uint8(len(full_label)) || full_label || uint8(ctx_len) || context
    where full_label = 'tls13 ' + label_ascii
    """
    full = b'tls13 ' + label_ascii
    hdr = bytes([length >> 8, length & 0xff, len(full)]) + full
    ctx_len = len(context_bv.v) // 8 if context_bv is not None and len(context_bv.v) > 0 else 0
    hdr += bytes([ctx_len])
    hdr_bv = bv_hex(hdr.hex())
    if ctx_len > 0:
        return bv_cat(hdr_bv, context_bv)
    return hdr_bv

def hkdf_expand_label(secret_bv, label_ascii, context_bv, length):
    """TLS 1.3 HKDF-Expand-Label."""
    info = _hkdf_label(length, label_ascii, context_bv)
    return hkdf_expand(secret_bv, info, length)

def derive_secret(secret_bv, label_ascii, transcript_hash_bv):
    """TLS 1.3 Derive-Secret = HKDF-Expand-Label(secret, label, Hash, HashLen)."""
    return hkdf_expand_label(secret_bv, label_ascii, transcript_hash_bv, 32)

# ============================================================
# AES-128-GCM
# ============================================================

def aes128_encrypt_block(key_bv, block_bv):
    """AES-128 encrypt a single 128-bit block. key and block are MSB-first sbitvec(128)."""
    ct_le = aes128_circuit(bv_reverse(key_bv), bv_reverse(block_bv))
    return bv_reverse(ct_le)

def _int_to_bv32(val):
    """Convert a compile-time integer to a 32-bit sbitvec (big-endian)."""
    bits = []
    for i in range(32):
        bits.append(sbit((val >> (31 - i)) & 1))
    return sbitvec.from_vec(bits)

def _make_ctr_block(nonce_bv, counter_int):
    """nonce_bv is 96-bit sbitvec, counter_int is a compile-time int."""
    return bv_cat(nonce_bv, _int_to_bv32(counter_int))

def _gf128_mul(a_bv, b_bv):
    """Multiply a * b in GF(2^128). Both are 128-bit sbitvecs.
    Uses the standard bit-by-bit algorithm with the GCM reduction polynomial
    R = 0xe1000000000000000000000000000000 (x^7 + x^2 + x + 1 shifted).
    """
    R_val = 0xe1000000000000000000000000000000
    R_bits = [(R_val >> (127 - j)) & 1 for j in range(128)]

    result = [sbit(0)] * 128
    v = list(b_bv.v)

    for i in range(128):
        a_bit = a_bv.v[i]
        for j in range(128):
            result[j] = result[j] ^ (a_bit & v[j])
        carry = v[127]
        v = [sbit(0)] + v[:127]
        for j in range(128):
            if R_bits[j]:
                v[j] = v[j] ^ carry
    return sbitvec.from_vec(result)

def _ghash(h_bv, aad_bv, ciphertext_bv):
    """GHASH for AES-GCM. h_bv is 128-bit hash key. Returns 128-bit tag."""
    y = bv_zeros(128)

    def process_blocks(data_bv):
        nonlocal y
        n_bits = len(data_bv.v)
        n_blocks = (n_bits + 127) // 128
        for i in range(n_blocks):
            start = i * 128
            end = min(start + 128, n_bits)
            block = data_bv.v[start:end]
            if len(block) < 128:
                block = block + [sbit(0)] * (128 - len(block))
            y = _gf128_mul(bv_xor(y, sbitvec.from_vec(block)), h_bv)

    process_blocks(aad_bv)
    process_blocks(ciphertext_bv)

    aad_len = len(aad_bv.v)
    ct_len = len(ciphertext_bv.v)
    len_block = bv_hex('%016x%016x' % (aad_len, ct_len))
    y = _gf128_mul(bv_xor(y, len_block), h_bv)
    return y

def aes128_gcm_decrypt(key_bv, nonce_bv, ciphertext_with_tag_bv, aad_bv):
    """AES-128-GCM decrypt. Returns plaintext sbitvec (without tag).
    key: 128 bits, nonce: 96 bits, aad: any length.
    ciphertext_with_tag includes 128-bit tag at the end.
    """
    total_bits = len(ciphertext_with_tag_bv.v)
    ct_bits = total_bits - 128
    ct_bv = bv_slice(ciphertext_with_tag_bv, 0, ct_bits)

    h_bv = aes128_encrypt_block(key_bv, bv_zeros(128))
    j0 = _make_ctr_block(nonce_bv, 1)

    n_blocks = (ct_bits + 127) // 128
    plaintext_bits = []
    for i in range(n_blocks):
        ctr = _make_ctr_block(nonce_bv, i + 2)
        ks = aes128_encrypt_block(key_bv, ctr)
        start = i * 128
        end = min(start + 128, ct_bits)
        ct_block = ct_bv.v[start:end]
        if len(ct_block) < 128:
            ct_block = ct_block + [sbit(0)] * (128 - len(ct_block))
        pt_block = [ct_block[j] ^ ks.v[j] for j in range(128)]
        plaintext_bits.extend(pt_block[:end - start])

    return sbitvec.from_vec(plaintext_bits)

def aes128_gcm_encrypt(key_bv, nonce_bv, plaintext_bv, aad_bv):
    """AES-128-GCM encrypt. Returns ciphertext || 128-bit tag as sbitvec."""
    h_bv = aes128_encrypt_block(key_bv, bv_zeros(128))
    j0 = _make_ctr_block(nonce_bv, 1)
    tag_mask = aes128_encrypt_block(key_bv, j0)

    pt_bits = len(plaintext_bv.v)
    n_blocks = (pt_bits + 127) // 128
    ct_bits = []
    for i in range(n_blocks):
        ctr = _make_ctr_block(nonce_bv, i + 2)
        ks = aes128_encrypt_block(key_bv, ctr)
        start = i * 128
        end = min(start + 128, pt_bits)
        pt_block = plaintext_bv.v[start:end]
        if len(pt_block) < 128:
            pt_block = pt_block + [sbit(0)] * (128 - len(pt_block))
        ct_block = [pt_block[j] ^ ks.v[j] for j in range(128)]
        ct_bits.extend(ct_block[:end - start])

    ct_bv = sbitvec.from_vec(ct_bits)
    ghash_tag = _ghash(h_bv, aad_bv, ct_bv)
    tag = bv_xor(ghash_tag, tag_mask)
    return bv_cat(ct_bv, tag)

# ============================================================
# TLS 1.3 nonce
# ============================================================

def tls_nonce(iv_bv, seq):
    """TLS 1.3 nonce: XOR iv (96 bits) with zero-padded 64-bit sequence number."""
    seq_bv = bv_cat(bv_zeros(32), _int_to_bv32(seq >> 32), _int_to_bv32(seq & 0xffffffff)) if seq > 0xffffffff else bv_cat(bv_zeros(64), _int_to_bv32(seq))
    return bv_xor(iv_bv, seq_bv)

# ============================================================
# TLS 1.3 key schedule
# ============================================================

_ZERO_32 = bv_hex('00' * 32)
_EMPTY_HASH = None  # computed lazily

def empty_hash():
    global _EMPTY_HASH
    if _EMPTY_HASH is None:
        _EMPTY_HASH = sha256(sbitvec.from_vec([]))
    return _EMPTY_HASH

def tls_key_schedule(shared_secret_bv, ch_bv, sh_bv, cipher_suite):
    """Derive handshake_secret and server/client handshake keys from CH+SH.
    All inputs/outputs are sbitvecs.
    Returns (handshake_secret, s_hs_key, s_hs_iv, c_hs_key, c_hs_iv, th_after_sh).
    """
    early_secret = hkdf_extract(_ZERO_32, _ZERO_32)
    derived = derive_secret(early_secret, b'derived', empty_hash())
    handshake_secret = hkdf_extract(derived, shared_secret_bv)

    transcript = bv_cat(ch_bv, sh_bv)
    th_after_sh = sha256(transcript)

    s_hs_traffic = derive_secret(handshake_secret, b's hs traffic', th_after_sh)
    s_key = hkdf_expand_label(s_hs_traffic, b'key', bv_zeros(0), 16)
    s_iv  = hkdf_expand_label(s_hs_traffic, b'iv',  bv_zeros(0), 12)

    c_hs_traffic = derive_secret(handshake_secret, b'c hs traffic', th_after_sh)
    c_key = hkdf_expand_label(c_hs_traffic, b'key', bv_zeros(0), 16)
    c_iv  = hkdf_expand_label(c_hs_traffic, b'iv',  bv_zeros(0), 12)

    fin_key = hkdf_expand_label(c_hs_traffic, b'finished', bv_zeros(0), 32)

    return handshake_secret, s_key, s_iv, c_key, c_iv, fin_key, th_after_sh

def tls_app_keys(handshake_secret_bv, transcript_through_sf_bv):
    """Derive application traffic keys.
    transcript_through_sf_bv = CH || SH || server_handshake_messages.
    Returns (c_app_key, c_app_iv, s_app_key, s_app_iv).
    """
    th_sf = sha256(transcript_through_sf_bv)
    derived = derive_secret(handshake_secret_bv, b'derived', empty_hash())
    master_secret = hkdf_extract(derived, _ZERO_32)

    c_ap = derive_secret(master_secret, b'c ap traffic', th_sf)
    s_ap = derive_secret(master_secret, b's ap traffic', th_sf)

    c_key = hkdf_expand_label(c_ap, b'key', bv_zeros(0), 16)
    c_iv  = hkdf_expand_label(c_ap, b'iv',  bv_zeros(0), 12)
    s_key = hkdf_expand_label(s_ap, b'key', bv_zeros(0), 16)
    s_iv  = hkdf_expand_label(s_ap, b'iv',  bv_zeros(0), 12)

    return c_key, c_iv, s_key, s_iv

def tls_finished(fin_key_bv, transcript_hash_bv):
    """Compute Client Finished verify_data = HMAC(finished_key, transcript_hash)."""
    return hmac_sha256(fin_key_bv, transcript_hash_bv)


# ============================================================
# Runtime sequence / CTR stream (used by otls_demo HS decrypt)
# ============================================================

def regint_bv32(val):
    """regint (runtime) → 32-bit MSB-first sbitvec (TLS record sequence)."""
    return sbitvec.from_vec([sbit((val >> regint(31 - i)) % 2) for i in range(32)])


def tls_nonce_r(iv_bv, seq_r):
    """TLS 1.3 nonce with runtime sequence number (e.g. server app records)."""
    return bv_xor(iv_bv, bv_cat(bv_zeros(64), regint_bv32(seq_r)))


def gcm_ctr(key_bv, nonce_bv, ct_bv, n_bytes):
    """AES-128-CTR keystream XOR (GCM encryption direction). n_bytes compile-time."""
    n_blk = (n_bytes + 15) // 16
    out = []
    for i in range(n_blk):
        ctr = _make_ctr_block(nonce_bv, i + 2)
        ks = aes128_encrypt_block(key_bv, ctr)
        s = i * 128
        e = min(s + 128, n_bytes * 8)
        for j in range(e - s):
            out.append(ct_bv.v[s + j] ^ ks.v[j])
    return sbitvec.from_vec(out)


# ============================================================
# Key schedule from transcript *hashes* (gateway precomputes SHA-256)
# ============================================================

def derive_hs_keys_from_th_hash(shared_secret_bv, transcript_ch_sh_hash_bv):
    """Same as TLS key schedule after ECDH: th = SHA256(ClientHello||ServerHello)."""
    early = hkdf_extract(_ZERO_32, _ZERO_32)
    der = derive_secret(early, b'derived', empty_hash())
    hs = hkdf_extract(der, shared_secret_bv)
    s_hs = derive_secret(hs, b's hs traffic', transcript_ch_sh_hash_bv)
    c_hs = derive_secret(hs, b'c hs traffic', transcript_ch_sh_hash_bv)
    return (hs,
            hkdf_expand_label(s_hs, b'key', bv_zeros(0), 16),
            hkdf_expand_label(s_hs, b'iv', bv_zeros(0), 12),
            hkdf_expand_label(c_hs, b'key', bv_zeros(0), 16),
            hkdf_expand_label(c_hs, b'iv', bv_zeros(0), 12),
            hkdf_expand_label(c_hs, b'finished', bv_zeros(0), 32))


def derive_app_keys_from_th_hash(hs_sec, transcript_through_sf_bv):
    """Application keys; transcript_through_sf_bv = hash through server Finished."""
    der = derive_secret(hs_sec, b'derived', empty_hash())
    ms = hkdf_extract(der, _ZERO_32)
    cap = derive_secret(ms, b'c ap traffic', transcript_through_sf_bv)
    sap = derive_secret(ms, b's ap traffic', transcript_through_sf_bv)
    return (hkdf_expand_label(cap, b'key', bv_zeros(0), 16),
            hkdf_expand_label(cap, b'iv', bv_zeros(0), 12),
            hkdf_expand_label(sap, b'key', bv_zeros(0), 16),
            hkdf_expand_label(sap, b'iv', bv_zeros(0), 12))


def build_tls_record(key_bv, iv_bv, seq, pt_bv, n_pt, inner_ct_type):
    """TLS 1.3 application data record: inner || type, AES-128-GCM, 5-byte header."""
    inner = bv_cat(pt_bv, bv_hex('%02x' % inner_ct_type))
    inner_len = n_pt + 1
    enc_len = inner_len + 16
    hdr = bv_hex('170303%04x' % enc_len)
    nonce = tls_nonce(iv_bv, seq)
    ct_tag = aes128_gcm_encrypt(key_bv, nonce, inner, hdr)
    return bv_cat(hdr, ct_tag), 5 + enc_len
